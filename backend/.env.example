# DMRC ONE Backend Environment Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional Supabase PostgreSQL database connection
# Format: postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres
DATABASE_URL=

# Optional LLM API keys for MetroMate AI tool calling
# If left empty, the built-in deterministic offline Tool-Calling Engine is active
GEMINI_API_KEY=
OPENAI_API_KEY=

